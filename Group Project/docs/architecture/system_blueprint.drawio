<mxfile host="app.diagrams.net"><diagram name="System Blueprint" id="blueprint"><mxGraphModel dx="1420" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="905" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;System Blueprint — Anti-Spoofing Login with Edge Liveness Detection on Raspberry Pi 5&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="14" y="8" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Sprints: &lt;b&gt;S0&lt;/b&gt; Wk 4  Planning | &lt;b&gt;S1&lt;/b&gt; Wk 5-6  Data &amp; Pi setup | &lt;b&gt;S2&lt;/b&gt; Wk 7-8  Modelling | &lt;b&gt;S3&lt;/b&gt; Wk 9-10  Integration | &lt;b&gt;S4&lt;/b&gt; Wk 11-12  Evaluation &amp; MLOps &amp;nbsp;&amp;nbsp; Arrows: solid = data flow, blue dashed = model/code artifact, red dotted = monitoring &amp;amp; feedback" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="14" y="40" width="1390" height="24" as="geometry"/></mxCell><mxCell id="laneA" value="&lt;b&gt;OFFLINE ML PIPELINE&lt;/b&gt;&lt;br&gt;laptop / Google Colab" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2F7FC;strokeColor=#5B8DB8;fontColor=#1F4E79;horizontal=0;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8" y="80" width="1404" height="272" as="geometry"/></mxCell><mxCell id="laneB" value="&lt;b&gt;EDGE DEVICE&lt;/b&gt;&lt;br&gt;Raspberry Pi 5 + Camera Module 3" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3FAF5;strokeColor=#4E9A66;fontColor=#1E5631;horizontal=0;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8" y="396" width="1404" height="196" as="geometry"/></mxCell><mxCell id="laneC" value="&lt;b&gt;APPLICATION &amp; OPS&lt;/b&gt;&lt;br&gt;web UI + backend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#C77A2E;fontColor=#7A4310;horizontal=0;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8" y="640" width="1404" height="182" as="geometry"/></mxCell><mxCell id="A1" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;1. Data Sources&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• CelebA-Spoof: 625k images, 10k subjects, live:spoof ≈ 1:3 (primary)&lt;/div&gt;&lt;div&gt;• Replay-Attack: print &amp;amp; video replay (EULA via tutor)&lt;/div&gt;&lt;div&gt;• Pi-camera sanity set (consented team captures)&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#7F7F7F&quot;&gt;&lt;b&gt;[S0–S1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56.0" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="A2" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;2. Ingestion &amp;amp; Versioning&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Download scripts + licence notes&lt;/div&gt;&lt;div&gt;• Manifest: path, label, subject ID, attack type, lighting, hash&lt;/div&gt;&lt;div&gt;• Raw data versioned with DVC&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#2E75B6&quot;&gt;&lt;b&gt;[S1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="283.2" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="A3" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;3. Preprocessing&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• YuNet face detection → crop (bbox × 2.7)&lt;/div&gt;&lt;div&gt;• Resize 80×80, normalise&lt;/div&gt;&lt;div&gt;• Quality filter: blur, brightness, face size&lt;/div&gt;&lt;div&gt;• Subject-disjoint split 80/10/10, test set frozen&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#2E75B6&quot;&gt;&lt;b&gt;[S1]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510.4" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="A4" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;4. Feature Engineering&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Learned CNN features (main path)&lt;/div&gt;&lt;div&gt;• LBP texture histograms (baseline)&lt;/div&gt;&lt;div&gt;• Augmentation: lighting, blur, JPEG, colour shift&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#2E75B6&quot;&gt;&lt;b&gt;[S1–S2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="737.6" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="A5" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;5. Training &amp;amp; Selection&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Baselines: LBP+SVM, pre-trained MiniFASNet&lt;/div&gt;&lt;div&gt;• Fine-tune MiniFASNet / MobileNetV3-S&lt;/div&gt;&lt;div&gt;• Class-weighted loss (1:3 imbalance)&lt;/div&gt;&lt;div&gt;• MLflow experiment tracking&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#7030A0&quot;&gt;&lt;b&gt;[S2]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="964.8" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="A6" value="&lt;b&gt;&lt;font color=&quot;#1F4E79&quot;&gt;6. Evaluation &amp;amp; Packaging&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Threshold chosen on validation (BPCER ≤ 5%)&lt;/div&gt;&lt;div&gt;• APCER / BPCER / ACER / AUC per attack type&lt;/div&gt;&lt;div&gt;• ONNX → INT8, versioned model + config&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#7030A0&quot;&gt;&lt;b&gt;[S2–S4]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8DB8;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1192.0" y="118.0" width="200.0" height="222.0" as="geometry"/></mxCell><mxCell id="B1" value="&lt;b&gt;&lt;font color=&quot;#1E5631&quot;&gt;7. Camera Capture&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• picamera2; user taps Start (consent)&lt;/div&gt;&lt;div&gt;• 10–15 frames in ~1.5 s&lt;/div&gt;&lt;div&gt;• Handles no camera / timeout&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#2E75B6&quot;&gt;&lt;b&gt;[S1, S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A66;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56.0" y="412.0" width="245.0" height="166.0" as="geometry"/></mxCell><mxCell id="B2" value="&lt;b&gt;&lt;font color=&quot;#1E5631&quot;&gt;8. On-device Preprocessing&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Same preprocessing module as training&lt;/div&gt;&lt;div&gt;• Checks: 1 face, light, blur, size&lt;/div&gt;&lt;div&gt;• Crop + normalise each frame&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A66;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="328.8" y="412.0" width="245.0" height="166.0" as="geometry"/></mxCell><mxCell id="B3" value="&lt;b&gt;&lt;font color=&quot;#1E5631&quot;&gt;9. PAD Inference (ML model)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• ONNX Runtime, INT8 model on Pi CPU&lt;/div&gt;&lt;div&gt;• Live score p_live per frame&lt;/div&gt;&lt;div&gt;• Temporal aggregation (median)&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#7030A0&quot;&gt;&lt;b&gt;[S2–S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A66;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="601.5" y="412.0" width="245.0" height="166.0" as="geometry"/></mxCell><mxCell id="B4" value="&lt;b&gt;&lt;font color=&quot;#1E5631&quot;&gt;10. Decision Engine (output)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• PASS / SPOOF SUSPECTED / RETRY / TECH FAILURE&lt;/div&gt;&lt;div&gt;• Fail-closed, retry limit, rate limit&lt;/div&gt;&lt;div&gt;• Result signed with nonce + model version&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A66;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="874.2" y="412.0" width="245.0" height="166.0" as="geometry"/></mxCell><mxCell id="B5" value="&lt;b&gt;&lt;font color=&quot;#1E5631&quot;&gt;11. Edge Telemetry&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Latency p50/p95, CPU temp, throttling&lt;/div&gt;&lt;div&gt;• Score &amp;amp; image-quality statistics&lt;/div&gt;&lt;div&gt;• No raw face images stored&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9A66;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1147.0" y="412.0" width="245.0" height="166.0" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;&lt;font color=&quot;#7A4310&quot;&gt;12. Web Login UI&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Username + password form&lt;/div&gt;&lt;div&gt;• Camera guidance &amp;amp; live status&lt;/div&gt;&lt;div&gt;• Clear retry / failure messages&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77A2E;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56.0" y="656.0" width="290.0" height="152.0" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;&lt;font color=&quot;#7A4310&quot;&gt;13. Backend Auth API (FastAPI)&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Checks credentials, issues nonce&lt;/div&gt;&lt;div&gt;• Verifies Pi signature &amp;amp; freshness&lt;/div&gt;&lt;div&gt;• Final login decision + audit log&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77A2E;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="404.7" y="656.0" width="290.0" height="152.0" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;&lt;font color=&quot;#7A4310&quot;&gt;14. Logging &amp;amp; Monitoring&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Attempt logs: decision, score, model ver.&lt;/div&gt;&lt;div&gt;• Dashboard: pass / spoof / retry rates, latency&lt;/div&gt;&lt;div&gt;• Weekly red-team audit set (labelled)&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#C55A11&quot;&gt;&lt;b&gt;[S3–S4]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77A2E;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="753.3" y="656.0" width="290.0" height="152.0" as="geometry"/></mxCell><mxCell id="C4" value="&lt;b&gt;&lt;font color=&quot;#7A4310&quot;&gt;15. Drift Detection &amp;amp; Retraining&lt;/font&gt;&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div&gt;• Data drift: PSI on quality &amp;amp; score features&lt;/div&gt;&lt;div&gt;• Concept drift: APCER / BPCER on audit set&lt;/div&gt;&lt;div&gt;• Triggers retraining (time / performance / drift)&lt;/div&gt;&lt;div style=&quot;text-align:right&quot;&gt;&lt;font color=&quot;#548235&quot;&gt;&lt;b&gt;[S4]&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C77A2E;align=left;verticalAlign=top;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1102.0" y="656.0" width="290.0" height="152.0" as="geometry"/></mxCell><mxCell id="devops" value="&lt;b&gt;DevOps &amp;amp; MLOps backbone (all sprints)&lt;/b&gt;&lt;br&gt;GitHub: code, configs, PR review, release tags &amp;nbsp;■ GitHub Actions: lint, unit tests, eval gate, release build &amp;nbsp;■ DVC: dataset &amp;amp; model-weight versions &amp;nbsp;■ MLflow: experiments + model registry &amp;nbsp;■ Jira: backlog, sprints, user stories" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEEAF6;strokeColor=#6B5B95;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="8" y="834" width="1404" height="63" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="256.0" y="229.0" as="sourcePoint"/><mxPoint x="283.2" y="229.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c6" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483.2" y="229.0" as="sourcePoint"/><mxPoint x="510.4" y="229.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.4" y="229.0" as="sourcePoint"/><mxPoint x="737.6" y="229.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="937.6" y="229.0" as="sourcePoint"/><mxPoint x="964.8" y="229.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1164.8" y="229.0" as="sourcePoint"/><mxPoint x="1192.0" y="229.0" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="301.0" y="495.0" as="sourcePoint"/><mxPoint x="328.8" y="495.0" as="targetPoint"/><Array as="points"></